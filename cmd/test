#!/usr/bin/env bash

source ./cmd/config

if [[ -d "$DIR_PATH" ]]; then
    read -rp "Directory $DIR_PATH already exists. Do you want to delete it? Y/n " should_delete

    if [[ "$should_delete" == "n" ]]; then
        exit 1
    fi

    rm -r "$DIR_PATH"
fi

./cmd/build

unzip "$ZIP_NAME" -d "$DIR_PATH"

echo 'Re-login to your shell to see extension changes or run: dbus-run-session -- gnome-shell --devkit --wayland'
