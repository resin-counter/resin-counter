#!/usr/bin/env bash

source ./cmd/config

npm run build

rm -f types.js "$ZIP_NAME"

files_exclude=(
    "src/*"
    ".git/*"
    ".vscode/*"
    "cmd/*"
    "node_modules/*"
    ".*" "*.zip"
    "tsconfig.json"
    "AGENTS.md"
    "Session.vim"
    "package.json"
    "package-lock.json"
)

zip -r "$ZIP_NAME" ./* .[^.]* -x "${files_exclude[@]}"
